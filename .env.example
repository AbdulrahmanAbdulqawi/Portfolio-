# Contact form email (Netlify function). Copy to .env for local dev; set in Netlify UI for production.
# Gmail: use an App Password (https://myaccount.google.com/apppasswords), not your normal password.

EMAIL_FROM=your-email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Admin panel API (server/AdminApi, self-hosted). Copy to .env for local dev;
# set in Netlify's env vars for production. No API configured = the public site
# falls back to the content bundled in src/data/*.ts and the admin panel can't log in.
VITE_API_BASE_URL=http://localhost:5080

# Used only by `npm run seed:content` (scripts/seed-content.ts) to push the bundled
# src/data/*.ts content into a freshly-deployed AdminApi. Not read by the app itself.
SEED_API_BASE_URL=http://localhost:5080
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
